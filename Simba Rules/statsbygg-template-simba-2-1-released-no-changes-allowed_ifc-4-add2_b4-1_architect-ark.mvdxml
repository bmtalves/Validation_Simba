                    <TemplateRules operator="or">
                      <TemplateRule Parameters="T_Set[Value]='Pset_CoveringCommon' AND T_PropertyName[Value]='IsExternal' AND T_Value[Exists]=TRUE AND T_Value[Type]='IFCBOOLEAN'"/>
                    </TemplateRules>
                  </TemplateRules>
                </TemplateRules>
              </TemplateRules>
            </Concept>
            <Concept uuid="00000489-4365-0000-0000-000004572778" name="NONS10010 IsProcured : NONS10001 NONS_Process : 200 Covering Flooring : 01 Architectural (ARK)" code="">
              <Definitions>
                <Definition>
                  <Body lang="en"><![CDATA[Kommuniserer at produktet som objektet representerer er innkjøpt. Selv om objektet ikke er ferdig prosjektert skal geometri og egenskaper være representative for det innkjøpte produktet. Denne kan brukes som alternativ til kode under ConstructedStatus som angir om produktet som objektet representerer er innkjøpt. : Egenskaper for prosessinformasjon. Egenskapene legges på objektforekomster i elementer.  : The covering is used to represent a flooring.]]></Body>
                </Definition>
              </Definitions>
