                  </Rules>
                </ConceptTemplate>
                <ConceptTemplate uuid="f289287f-aab7-4d10-b8ac-e1389c8cc4e1" name="Reinforcing Bar Attributes" status="sample" applicableSchema="IFC4" applicableEntity="IfcReinforcingBar">
                  <Rules>
