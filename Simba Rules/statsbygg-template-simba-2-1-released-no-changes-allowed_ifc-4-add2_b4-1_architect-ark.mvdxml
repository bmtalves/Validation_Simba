                  <TemplateRule Parameters="Set[Value]='NONS_Process' AND PropertyName[Value]='IsProcured' AND Value[Exists]=TRUE AND Value[Type]='IFCBOOLEAN'"/>
                  <TemplateRules operator="and">
                    <TemplateRules operator="nor">
