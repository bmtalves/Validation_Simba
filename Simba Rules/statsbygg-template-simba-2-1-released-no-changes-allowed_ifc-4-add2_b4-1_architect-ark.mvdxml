              </TemplateRules>
            </Concept>
            <Concept uuid="00000489-4365-0000-0000-000004568327" name="NONS10102 RefString : NONS10101 NONS_Reference : 200 773 Furniture : 01 Architectural (ARK)" code="">
              <Definitions>
                <Definition>
                  <Body lang="en"><![CDATA[Sammensatt TFM-ID (kodestreng) i byggeierens foretrukne format. Det skal avtales om denne kreves, og hvilket format den skal ha. I IFC bør dette ligge i IfcXxxxxx.Tag eller i egenskapen «Reference» i Pset  IfcXxxxxxCommon. : Egenskapssett for alle TFM-relaterte egenskaper : Furniture defines complete furnishings such as a table, desk, chair, or cabinet, which may or may not be permanently attached to a building structure.]]></Body>
                </Definition>
              </Definitions>
              <Template ref="00000000-0000-0000-0001-000000000001"/>
              <Requirements>
                <Requirement applicability="export" exchangeRequirement="00000489-4365-4366-0000-000000000000" requirement="mandatory"/>
                <Requirement applicability="export" exchangeRequirement="00000489-4365-4367-0000-000000000000" requirement="mandatory"/>
              </Requirements>
              <TemplateRules operator="and">
                <TemplateRules operator="or">
                  <TemplateRule Parameters="Set[Value]='NONS_Reference' AND PropertyName[Value]='RefString' AND Value[Exists]=TRUE AND Value[Type]='IFCLABEL'"/>
                  <TemplateRules operator="and">
                    <TemplateRules operator="nor">
                      <TemplateRule Parameters="Set[Value]='NONS_Reference' AND PropertyName[Value]='RefString'"/>
                    </TemplateRules>
                    <TemplateRules operator="or">
                      <TemplateRule Parameters="T_Set[Value]='NONS_Reference' AND T_PropertyName[Value]='RefString' AND T_Value[Exists]=TRUE AND T_Value[Type]='IFCLABEL'"/>
