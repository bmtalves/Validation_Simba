	<!-- 20.04.2022: Generic template for checking material names "AllMaterialTypesWithOverride"
	     Material Name for Single, Constituent Set, Material Layer Set (Usage) and Material Profile Set (Usage) with Override
		 set applicableEntity to IfcObjectDefinition to be usable by Occurrence and Type entities (use for self-reference for override functionality) -->
	<ConceptTemplate uuid="00000000-0000-0000-0001-000000000004" name="Material with Override" status="sample" applicableSchema="IFC4" applicableEntity="IfcObjectDefinition">
        <Definitions>
          <Definition>
            <Body lang="en"><![CDATA[Concept Template for any Product, enables to select entities based on their material]]></Body>
          </Definition>
   	  <Definition>
		  <Body lang="tt"><![CDATA[<TemplateRules operator="or">
	<TemplateRule Parameters="MaterialName[Value]=reg'.*(C|c)oncrete'"/>
	<TemplateRules operator="and">
		<TemplateRule Parameters="TypeMaterialName[Value]=reg'.*(C|c)oncrete'"/>
		<TemplateRules operator="nor">
			<TemplateRule Parameters="MaterialName[Exists]=TRUE"/>
		</TemplateRules>
	</TemplateRules>
</TemplateRules>]]></Body>
		  <Link lang="tt" category="definition" title="AUTOMATIC" href=""><![CDATA[]]></Link>
	  </Definition>
        </Definitions>
	  <Rules>
		<AttributeRule AttributeName="HasAssociations">
		  <EntityRules>
			<EntityRule EntityName="IfcRelAssociatesMaterial">
			  <AttributeRules>
				<AttributeRule AttributeName="RelatingMaterial">
