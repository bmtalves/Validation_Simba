                  <TemplateRule Parameters="Set[Value]='Pset_BuildingElementProxyCommon' AND PropertyName[Value]='ThermalTransmittance' AND Value[Exists]=TRUE AND Value[Type]='IFCTHERMALTRANSMITTANCEMEASURE'"/>
                  <TemplateRules operator="and">
                    <TemplateRules operator="nor">
                      <TemplateRule Parameters="Set[Value]='Pset_BuildingElementProxyCommon' AND PropertyName[Value]='ThermalTransmittance'"/>
                    </TemplateRules>
                    <TemplateRules operator="or">
                      <TemplateRule Parameters="T_Set[Value]='Pset_BuildingElementProxyCommon' AND T_PropertyName[Value]='ThermalTransmittance' AND T_Value[Exists]=TRUE AND T_Value[Type]='IFCTHERMALTRANSMITTANCEMEASURE'"/>
