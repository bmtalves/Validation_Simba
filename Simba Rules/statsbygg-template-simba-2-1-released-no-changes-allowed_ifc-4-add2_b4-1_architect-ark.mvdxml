            </Definition>
          </Definitions>
        </ExchangeRequirement>
        <ExchangeRequirement uuid="00000489-4365-4367-0000-000000000000" name="B4.1.9 Coordinated design (B4.1 Detaljprosjekt) .9" applicability="export">
          <Definitions>
            <Definition>
              <Body><![CDATA[Iht Statsbyggs Prosjektmodell 2016 - "B" = "Beslutningsport"]]></Body>
