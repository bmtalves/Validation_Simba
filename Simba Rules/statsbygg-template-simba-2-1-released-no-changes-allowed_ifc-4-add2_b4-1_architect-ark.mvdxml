        <ConceptRoot uuid="00000489-4365-0000-0000-000004554957" name="003 Building" applicableRootEntity="IfcBuilding">
          <Definitions>
            <Definition>
              <Body><![CDATA[A building represents a structure that provides shelter for its occupants or contents and stands in one place. The building is also used to provide a basic element within the spatial structure hierarchy for the components of a building project (together with site, storey, and space).]]></Body>
            </Definition>
          </Definitions>
          <Concepts>
            <Concept uuid="00000489-4365-0000-0000-000004791082" name="0001- BuildingName : 003 Building : 01 Architectural (ARK)" code="">
              <Definitions>
                <Definition>
                  <Body lang="en"><![CDATA[A descriptive name of the building volume represented by the building object, e.g. "Block D". : A building represents a structure that provides shelter for its occupants or contents and stands in one place. The building is also used to provide a basic element within the spatial structure hierarchy for the components of a building project (together with site, storey, and space).]]></Body>
                </Definition>
              </Definitions>
