                  <TemplateRule Parameters="Set[Value]='Pset_RampFlightCommon' AND PropertyName[Value]='Headroom' AND Value[Exists]=TRUE AND Value[Type]='IFCPOSITIVELENGTHMEASURE'"/>
                  <TemplateRules operator="and">
                    <TemplateRules operator="nor">
                      <TemplateRule Parameters="Set[Value]='Pset_RampFlightCommon' AND PropertyName[Value]='Headroom'"/>
                    </TemplateRules>
                    <TemplateRules operator="or">
                      <TemplateRule Parameters="T_Set[Value]='Pset_RampFlightCommon' AND T_PropertyName[Value]='Headroom' AND T_Value[Exists]=TRUE AND T_Value[Type]='IFCPOSITIVELENGTHMEASURE'"/>
                    </TemplateRules>
