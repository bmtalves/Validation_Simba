                      <TemplateRule Parameters="T_Set[Value]='Pset_BuildingStoreyCommon' AND T_PropertyName[Value]='AboveGround' AND T_Value[Exists]=TRUE AND T_Value[Type]='IFCLOGICAL'"/>
