            <Concept uuid="00000489-4365-0000-0000-000004558758" name="286f3f00d1c411e1800000215ad4efdf IsExternal : f9f16400d1c311e1800000215ad4efdf Pset_BeamCommon : 223 Beam : 01 Architectural (ARK)" code="0eRpy0qSGHuO00025QrE$V">
