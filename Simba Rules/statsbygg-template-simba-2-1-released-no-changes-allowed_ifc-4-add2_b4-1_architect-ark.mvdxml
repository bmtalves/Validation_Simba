                    <TemplateRules operator="or">
                      <TemplateRule Parameters="T_Set[Value]='Pset_BuildingStoreyCommon' AND T_PropertyName[Value]='EntranceLevel' AND T_Value[Exists]=TRUE AND T_Value[Type]='IFCBOOLEAN'"/>
                    </TemplateRules>
                  </TemplateRules>
                </TemplateRules>
              </TemplateRules>
