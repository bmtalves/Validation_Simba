                                        <EntityRule EntityName="IfcPositiveLengthMeasure"/>
                                      </EntityRules>
                                    </AttributeRule>
                                    <AttributeRule AttributeName="BendingShapeCode">
                                      <EntityRules>
                                        <EntityRule EntityName="IfcLabel"/>
                                      </EntityRules>
                                    </AttributeRule>
                                    <AttributeRule AttributeName="BendingParameters">
                                      <EntityRules>
