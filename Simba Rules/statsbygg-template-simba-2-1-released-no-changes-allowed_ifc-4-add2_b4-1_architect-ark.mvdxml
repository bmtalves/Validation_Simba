                    </TemplateRules>
                    <TemplateRules operator="or">
                      <TemplateRule Parameters="T_Set[Value]='Pset_RailingCommon' AND T_PropertyName[Value]='Height' AND T_Value[Exists]=TRUE AND T_Value[Type]='IFCPOSITIVELENGTHMEASURE'"/>
                    </TemplateRules>
                  </TemplateRules>
                </TemplateRules>
              </TemplateRules>
