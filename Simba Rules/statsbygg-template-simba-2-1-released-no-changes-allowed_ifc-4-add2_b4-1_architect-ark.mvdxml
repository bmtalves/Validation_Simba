            <Concept uuid="00000489-4365-0000-0000-000004571552" name="NONS10008 DuplicateOwnedBy : NONS10001 NONS_Process : 200 760 771 Slab : 01 Architectural (ARK)" code="">
              <Definitions>
                <Definition>
                  <Body lang="en"><![CDATA[Kommuniserer at et annet fag er ansvarlig for objektet. Objektet er tatt med i modellen for å vise utseende, plassering eller lignende, men teknisk informasjon om objektet er beskrevet i modellen til faget som er ansvarlig. Dette kan for eksempel være søyler, toaletter eller lamper som er tatt med som dupliserte objekter i arkitektmodellen for å vise plasseringen, mens objektene med teknisk informasjon ligger i modellene til RIB, RIV og RIE. Verdien for egenskapen fylles ut med fagforkortelsen til faget som har ansvaret for objektet, for eksempel ARK, RIB, RIV, RIE, LARK osv. : Egenskaper for prosessinformasjon. Egenskapene legges på objektforekomster i elementer.  : A slab is a component of the construction that normally encloses a space vertically. The slab may provide the lower support (floor) or upper construction (roof slab) in any space in a building.]]></Body>
                </Definition>
              </Definitions>
              <Template ref="00000000-0000-0000-0001-000000000001"/>
              <Requirements>
                <Requirement applicability="export" exchangeRequirement="00000489-4365-4365-0000-000000000000" requirement="mandatory"/>
                <Requirement applicability="export" exchangeRequirement="00000489-4365-4366-0000-000000000000" requirement="mandatory"/>
                <Requirement applicability="export" exchangeRequirement="00000489-4365-4367-0000-000000000000" requirement="mandatory"/>
              </Requirements>
              <TemplateRules operator="and">
                <TemplateRules operator="or">
                  <TemplateRule Parameters="Set[Value]='NONS_Process' AND PropertyName[Value]='DuplicateOwnedBy' AND Value[Exists]=TRUE AND Value[Type]='IFCLABEL'"/>
                  <TemplateRules operator="and">
                    <TemplateRules operator="nor">
                      <TemplateRule Parameters="Set[Value]='NONS_Process' AND PropertyName[Value]='DuplicateOwnedBy'"/>
                    </TemplateRules>
                    <TemplateRules operator="or">
                      <TemplateRule Parameters="T_Set[Value]='NONS_Process' AND T_PropertyName[Value]='DuplicateOwnedBy' AND T_Value[Exists]=TRUE AND T_Value[Type]='IFCLABEL'"/>
                    </TemplateRules>
                  </TemplateRules>
                </TemplateRules>
              </TemplateRules>
            </Concept>
