            <Concept uuid="00000489-4365-0000-0000-000004572763" name="NONS10010 IsProcured : NONS10001 NONS_Process : 100 Flow Segment : 01 Architectural (ARK)" code="">
              <Definitions>
                <Definition>
                  <Body lang="en"><![CDATA[Kommuniserer at produktet som objektet representerer er innkjøpt. Selv om objektet ikke er ferdig prosjektert skal geometri og egenskaper være representative for det innkjøpte produktet. Denne kan brukes som alternativ til kode under ConstructedStatus som angir om produktet som objektet representerer er innkjøpt. : Egenskaper for prosessinformasjon. Egenskapene legges på objektforekomster i elementer.  : The distribution flow element IfcFlowSegment defines the occurrence of a segment of a flow distribution system.]]></Body>
                </Definition>
              </Definitions>
              <Template ref="00000000-0000-0000-0001-000000000001"/>
              <Requirements>
                <Requirement applicability="export" exchangeRequirement="00000489-4365-4365-0000-000000000000" requirement="mandatory"/>
                <Requirement applicability="export" exchangeRequirement="00000489-4365-4366-0000-000000000000" requirement="mandatory"/>
                <Requirement applicability="export" exchangeRequirement="00000489-4365-4367-0000-000000000000" requirement="mandatory"/>
              </Requirements>
              <TemplateRules operator="and">
                <TemplateRules operator="or">
                  <TemplateRule Parameters="Set[Value]='NONS_Process' AND PropertyName[Value]='IsProcured' AND Value[Exists]=TRUE AND Value[Type]='IFCBOOLEAN'"/>
                  <TemplateRules operator="and">
                    <TemplateRules operator="nor">
                      <TemplateRule Parameters="Set[Value]='NONS_Process' AND PropertyName[Value]='IsProcured'"/>
                    </TemplateRules>
                    <TemplateRules operator="or">
                      <TemplateRule Parameters="T_Set[Value]='NONS_Process' AND T_PropertyName[Value]='IsProcured' AND T_Value[Exists]=TRUE AND T_Value[Type]='IFCBOOLEAN'"/>
                    </TemplateRules>
                  </TemplateRules>
                </TemplateRules>
              </TemplateRules>
            </Concept>
