                    </TemplateRules>
                    <TemplateRules operator="or">
                      <TemplateRule Parameters="T_Set[Value]='NONS_Process' AND T_PropertyName[Value]='ProcessStatus' AND T_Value[Exists]=TRUE AND T_Value[Type]='IFCLABEL'"/>
                    </TemplateRules>
