        <ConceptRoot uuid="00000489-4365-0000-0000-000004555240" name="200 Covering Ceiling" applicableRootEntity="IfcCovering">
          <Definitions>
            <Definition>
              <Body><![CDATA[The covering is used to represent a ceiling.]]></Body>
            </Definition>
          </Definitions>
          <Applicability>
