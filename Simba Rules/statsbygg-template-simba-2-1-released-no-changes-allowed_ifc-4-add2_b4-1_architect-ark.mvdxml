                                      </EntityRules>
                                    </AttributeRule>
                                    <AttributeRule AttributeName="LongitudinalBarCrossSectionArea">
                                      <EntityRules>
                                        <EntityRule EntityName="IfcAreaMeasure"/>
                                      </EntityRules>
                                    </AttributeRule>
                                    <AttributeRule AttributeName="TransverseBarCrossSectionArea">
