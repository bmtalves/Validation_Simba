                      <TemplateRule Parameters="T_Set[Value]='Pset_SlabCommon' AND T_PropertyName[Value]='IsExternal' AND T_Value[Exists]=TRUE AND T_Value[Type]='IFCBOOLEAN'"/>
                    </TemplateRules>
                  </TemplateRules>
                </TemplateRules>
