                    <TemplateRules operator="or">
                      <TemplateRule Parameters="T_Set[Value]='NONS_Reference' AND T_PropertyName[Value]='RefString' AND T_Value[Exists]=TRUE AND T_Value[Type]='IFCLABEL'"/>
                    </TemplateRules>
